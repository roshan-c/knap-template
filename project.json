{
  "meta": {
    "title": "Local-First Markdown Publishing with Knap and Pandoc",
    "author": "Roshan",
    "date": "2026-11-07",
    "abstract": "This report describes a small, local, source-first Markdown publishing pipeline. The manuscript lives in Markdown; metadata and bibliographic data live in JSON. Knap generates front matter and a build appendix, and Pandoc publishes HTML and PDF with citations and a bibliography."
  },
  "pipeline": [
    {
      "stage": "Source",
      "file": "report.md",
      "tool": "VS Code",
      "output": "Manuscript with citations and the generated-build-appendix marker"
    },
    {
      "stage": "Data",
      "file": "project.json",
      "tool": "VS Code",
      "output": "Metadata, pipeline description, and CSL JSON references"
    },
    {
      "stage": "Template",
      "file": "templates/frontmatter.kmd, templates/reference-index.kmd",
      "tool": "Knap 0.4.2",
      "output": "YAML front matter and the build appendix"
    },
    {
      "stage": "Render",
      "file": "scripts/build.mjs",
      "tool": "Node.js 20+",
      "output": "build/report.md and build/reference-index.md"
    },
    {
      "stage": "Publish",
      "file": "build/report.md",
      "tool": "Pandoc + headless Chromium browser",
      "output": "build/report.html and build/report.pdf"
    }
  ],
