{
  "name": "knap-template",
  "version": "0.1.0",
  "private": true,
  "description": "Local, source-first Markdown publishing with Knap templates and Pandoc",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "knap validate templates/frontmatter.kmd && knap validate templates/reference-index.kmd",
    "render": "node scripts/build.mjs",
    "html": "npm run render && node scripts/html.mjs",
    "pdf": "npm run html && node scripts/pdf.mjs",
    "build": "npm run pdf",
    "clean": "node scripts/clean.mjs",
    "test": "node --test",
    "wordcount": "npm run render && node scripts/wordcount.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "css-tree": "3.2.1",
    "knap": "0.4.2",
    "pele": "1.13.0"
  }
}
